# =============================================================================
# Environment variables — NAMES ONLY. Never commit a real value here.
#
# Copy to .env.local for development. .env* is gitignored except this file.
# Validate these at startup with Zod so a missing variable fails the boot
# instead of producing a 500 in production at 2am.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Supabase
# NEXT_PUBLIC_* reaches the browser. Everything else must not.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely — treat as a root password.
# One server-only module should import it. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Pooler connection string. Serverless functions open many short-lived
# connections; the direct URL exhausts the connection limit under load.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Email (Resend) — SERVER ONLY
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# Non-production safety net: every recipient is redirected here unless the
# address is on EMAIL_ALLOWLIST. Development email must never reach a customer.
DEV_EMAIL_SINK=
EMAIL_ALLOWLIST=

# -----------------------------------------------------------------------------
# Payments — SERVER ONLY
# -----------------------------------------------------------------------------
PAYMENT_MERCHANT_ID=
PAYMENT_MERCHANT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Scheduled jobs
# Protects cron routes. Without it, anyone can trigger your queue drain.
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
TEST_WEBHOOK_SECRET=
